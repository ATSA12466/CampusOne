# Copy to .env and edit. Node loads it with: node --env-file=.env ...  (the start script does not need it if you set real env vars)
PORT=3000

# REQUIRED in production: a long random string. It signs login tokens and
# encrypts integration secrets at rest. Changing it makes saved secrets unreadable.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# First super admin. Created only if no super admin exists yet.
# If ADMIN_PASSWORD is empty a random one is generated and printed once.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# Where the SQLite file lives (mount a persistent volume here when deploying).
DATA_DIR=./data

# Safety switch. While false, announcements and invites are DRY RUNS: nothing is
# actually sent by e-mail, SMS or push. Turn on only after testing each integration.
ALLOW_LIVE_SENDING=false

# Set to true when served over HTTPS (adds the Secure flag to the session cookie).
COOKIE_SECURE=false

# Comma-separated extra origins allowed to call the API from a browser (e.g. a web version of the app).
CORS_ORIGINS=

# Set when behind a reverse proxy (Render, Fly, nginx) so rate limits see the real client IP.
TRUST_PROXY=false

# Country code used to turn 024... into +233... for SMS.
DEFAULT_COUNTRY_CODE=233
