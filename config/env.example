# Browser requests are same-origin. Next forwards API fallbacks to platform port 4000.
NEXT_PUBLIC_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:4000
# Server Home forwards only these exact session-cookie names. Empty forwards none.
# Set the real names agreed with your backend; never put cookie values here.
API_SESSION_COOKIE_NAMES=

# Demo is the default. API mode currently switches only new async catalog consumers.
NEXT_PUBLIC_DATA_SOURCE=demo

# Optional: your real deployment origin, for absolute social-preview image URLs.
# NEXT_PUBLIC_APP_URL=https://campusone.example.org

# Optional: comma-separated exact HTTPS image hostnames you own/license.
# NEXT_PUBLIC_IMAGE_HOSTS=images.example.org

# DATABASE_URL is server-only. Set a real value outside Git only if enabling DB health.
# Never put credentials in NEXT_PUBLIC_* variables.
